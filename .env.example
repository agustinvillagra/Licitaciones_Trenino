# Copiar a .env para correr en local. El .env NO se sube al repositorio.
TICKET_MERCADO_PUBLICO=tu-ticket-de-chilecompra
# Envío por Gmail: llega a cualquier destinatario, no necesita dominio propio.
# La clave es una "contraseña de aplicación" de 16 caracteres, no la del correo.
GMAIL_USUARIO=comunicaciones.trenino@gmail.com
GMAIL_CLAVE_APP=xxxxxxxxxxxxxxxx
# Alternativa: Resend. Sin dominio verificado solo envía al dueño de la cuenta.
RESEND_API_KEY=re_xxxxxxxxxxxx
CORREO_DESTINO=cgiacamanh@gmail.com,agustinvillagravial@uc.cl
CORREO_ORIGEN="Licitaciones Trenino <comunicaciones.trenino@gmail.com>"
SITIO_URL=https://licitacionestrenino.vercel.app
